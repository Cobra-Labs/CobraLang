def strlen(s: ptr<u8>) -> i32:
    let i: i32 = 0
    while s[i] != 0:
        i = i + 1
    return i

def print(s: ptr<u8>) -> i32:
    syscall(1, 1, s, strlen(s))
    return 0

def println(s: ptr<u8>) -> i32:
    print(s)
    print("\n")
    return 0

