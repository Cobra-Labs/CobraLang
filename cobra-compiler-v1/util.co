def len(str: ptr<u8>) -> i32:
    let i: i32 = 0
    while str[i] != 0:
        i = i + 1
    return i

def min(arr: ptr<i32>, length: i32) -> i32:
    let smallest: i32 = arr[0]
    let i: i32 = 1
    while i < length:
        if arr[i] < smallest:
            smallest = arr[i]

        i = i + 1

    return smallest

def max(arr: ptr<i32>, length: i32) -> i32:
    let largest: i32 = arr[0]
    let i: i32 = 1

    while i < length:
        if arr[i] > largest:
            largest = arr[i]

        i = i + 1

    return largest

def main() -> i32:
    return 0