from richText import printc

struct CobraError:
    code: i32        # E001, E002...
    name: ptr<u8>
    message: ptr<u8>
    file: ptr<u8>
    line: i32
    col: i32
    length: i32      # für ^^^
    hint: ptr<u8>    # "meintest du..."

def print_error(err: ptr<CobraError>, source: ptr<u8>) -> i32:
    # "error[E001]: message"
    printc("error", "red", "bold")
    print("[E")
    print(err.code)
    print("]: ")
    printcln(err.name, "white", "bold")

    # "  --> file:line:col"
    printc("  --> ", "none", "bold")
    print(err.file)
    print(":")
    print(err.line)
    print(":")
    print(err.col)
    print("\n")

    # Quellzeile
    printc("   | \n ", "none", "bold")
    # Zeilennummer + Quellzeile
    print(err.line)
    printc(" | ", "none", "bold")
    print_source_line(source, err.line)
    print("\n")

    # ^^^
    printc("   | ", "none", "bold")
    print("")
    printc("^^^", "red", "bold")
    print(" ")
    printcln(err.message, "red", "none")

    # Hint
    if err.hint != "":
        printc("   = hinweis: ", "cyan", "bold")
        printcln(err.hint, "none", "none")

    return 0

def print_source_line(source: ptr<u8>, line: i32) -> i32:
    print(source)
    return 0

def raise_error(type: ptr<u8>, file: ptr<u8>, line: i32, col: i32, len: i32, source: ptr<u8>, keyword: ptr<u8>, hint: ptr<u8>) -> i32:
    if streq(type, "SyntaxError"):
        let err: ptr<CobraError> = alloc(100)
        err.code = 1
        err.name = "SyntaxError"
        err.message = keyword
        err.file = file
        err.line = line
        err.col = col
        err.length = len
        err.hint = hint
        print_error(err, source)
    return 0

def main() -> i32:
    raise_error("SyntaxError", "main.co", 1, 1, 3, "dee main() -> i32:", "'dee' existiert nicht", "Meintest du 'def'?")
    return 0
