from richText import printc
from util import len
from util import min
from util import max

struct CobraError:
    code: i32        # E001, E002...
    name: ptr<u8>
    message: ptr<u8>
    file: ptr<u8>
    line: i32
    col: i32
    length: i32      # für ^^^
    hint: ptr<u8>    # "meintest du..."


def print_error(err: ptr<CobraError>, source: ptr<u8>) -> i32:
    # "error[E001]: message"
    printc("error", "red", "bold")
    print("[E")
    print(err.code)
    print("]: ")
    printcln(err.name, "white", "bold")

    # "  --> file:line:col"
    printc("  --> ", "none", "bold")
    print(err.file)
    print(":")
    print(err.line)
    print(":")
    print(err.col)
    print("\n")

    # Quellzeile
    if err.line < 10:
        printc("   | \n ", "none", "bold")
    if err.line < 100 > 10:
        printc("    | \n  ", "none", "bold")
    if err.line < 1000 > 100 > 10:
        printc("     | \n   ", "none", "bold")
    if err.line < 10000 > 1000 > 100 > 10:
        printc("      | \n    ", "none", "bold")
    # Zeilennummer + Quellzeile
    print(err.line)
    printc(" | ", "none", "bold")
    print_source_line(source, err.line)
    print("\n")

    # ^^^
    if err.line < 10:
        printc("   | ", "none", "bold")
    if err.line < 100 > 10:
        printc("    | ", "none", "bold")
    if err.line < 1000 > 100 > 10:
        printc("     | ", "none", "bold")
    if err.line < 10000 > 1000 > 100 > 10:
        printc("      | ", "none", "bold")
    let c: i32 = 0
    while c != err.col:
        c = c + 1
        if c != 1:
            print(" ")
    let i: i32 = 0
    while i < err.length:
        printc("^", "red", "bold")
        i = i + 1
    print(" ")
    printcln(err.message, "red", "none")

    # Hint
    if err.hint != "":
        printc("   = hinweis: Meintest du '", "cyan", "bold")
        printc(err.hint, "green", "bold")
        printcln("'?", "cyan", "bold")

    return 0

def print_source_line(source: ptr<u8>, line: i32) -> i32:
    print(source)
    return 0

def raise_error(type: ptr<u8>, file: ptr<u8>, line: i32, col: i32, len: i32, source: ptr<u8>, keyword: ptr<u8>, hint: ptr<u8>) -> i32:
    let err: ptr<CobraError> = alloc(100)
    err.message = keyword
    err.file = file
    err.line = line
    err.col = col
    err.length = len
    err.hint = hint
    if streq(type, "SyntaxError"):
        err.code = 1
        err.name = "SyntaxError"
        print_error(err, source)
    if streq(type, "KeyError"):
        err.code = 2
        err.name = "KeyError"
        print_error(err, source)
    if streq(type, "TypeMismatchError"):
        err.code = 3
        err.name = "TypeMismatchError")
        print_error(err, source)
    return 0



def levenshtein(s1: ptr<u8>, s2: ptr<u8>) -> i32:
    let len1: i32 = len(s1)
    let len2: i32 = len(s2)

    # v0 und v1 groß genug reservieren
    let v0: ptr<i32> = alloc((len2 + 1) * 4)
    sleep(1)
    let v1: ptr<i32> = alloc((len2 + 1) * 4)

    let i: i32 = 0
    while i <= len2:
        v0[i] = i
        i = i + 1

    i = 0
    while i < len1:
        v1[0] = i + 1

        let j: i32 = 0
        while j < len2:
            # WICHTIG: Expliziter Vergleich
            let cost: i32 = 1
            if s1[i] == s2[j]:
                cost = 0

            # Die drei Wege berechnen
            let del_cost: i32 = v0[j + 1] + 1
            let ins_cost: i32 = v1[j] + 1
            let sub_cost: i32 = v0[j] + cost

            # Manuelles Minimum (Sicherer als Pointer-Array)
            let res: i32 = del_cost
            if ins_cost < res:
                res = ins_cost
            if sub_cost < res:
                res = sub_cost

            v1[j + 1] = res
            j = j + 1

        let k: i32 = 0
        while k <= len2:
            v0[k] = v1[k]
            k = k + 1

        i = i + 1

    return v0[len2]

def find_suggestion(input: ptr<u8>, count: i32, target: ptr<ptr<u8> >) -> i32:
    # Starte mit einer sehr hohen Distanz
    let best_dist: i32 = 99
    let best_match: i32 = 0

    let i: i32 = 0 # Starte bei 0, um alle Keywords zu prüfen
    while i < count:
        let current_target: ptr<u8> = target[i]

        # Überspringe leere Strings, falls vorhanden
        if len(current_target) > 0:
            let d: i32 = levenshtein(input, current_target)

            # WICHTIG: d < best_dist (Wir wollen die KLEINSTE Distanz)
            if d < best_dist:
                best_dist = d
                best_match = i

        i = i + 1

    # Nur zurückgeben, wenn es ein plausibler Tippfehler ist (Distanz 1 oder 2)
    if best_dist <= 2:
        return best_match

    return 0

def handle_unknown_ident(name: ptr<u8>, file: ptr<u8>, line: i32, col: i32, source: ptr<u8>) -> i32:
    let keywords: ptr<ptr<u8> > = alloc(9 * 8)
    keywords[0] = ""
    keywords[1] = "if"
    keywords[2] = "while"
    keywords[3] = "return"
    keywords[4] = "for"
    keywords[5] = "in"
    keywords[6] = "def"
    keywords[7] = "struct"
    keywords[8] = "let"
    let kw_idx: i32 = find_suggestion(name, 9, keywords)

    if kw_idx != 0:
        let hint_text: ptr<u8> = keywords[kw_idx]
        raise_error("SyntaxError", file, line, col, len(name), source, "Unbekannter Bezeichner", hint_text)
        return 1

    return 0

def main() -> i32:
    handle_unknown_ident("wifle", "main.co", 1, 1, "wifle x >= 10:")
    return 0